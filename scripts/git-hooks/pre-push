#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1

node scripts/remove-injected-dropper.mjs --push
status=$?
if [ "$status" -ne 0 ]; then
  exit "$status"
fi

node scripts/check-obfuscated-js.mjs
status=$?
if [ "$status" -ne 0 ]; then
  echo "Push blocked. Remove obfuscated JavaScript before pushing."
  exit "$status"
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if git cat-file -e "$local_sha:api.js" 2>/dev/null || git cat-file -e "$local_sha:branch_structure.json" 2>/dev/null; then
    echo "Push blocked. $local_ref still contains api.js."
    exit 1
  fi
  if git show "$local_sha:package.json" 2>/dev/null | grep -q "node api.js"; then
    echo "Push blocked. $local_ref still runs node api.js."
    exit 1
  fi
  node scripts/check-obfuscated-js.mjs --revision "$local_sha"
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "Push blocked. $local_ref contains obfuscated JavaScript."
    exit "$status"
  fi
done

exit 0
